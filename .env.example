# EZVIZ Open Platform credentials from Console -> My Applications.
# Do not commit real values.
YS7_APP_KEY=
YS7_APP_SECRET=
# Optional alternative to AppKey/AppSecret. The token normally expires in 7 days.
YS7_ACCESS_TOKEN=
YS7_DEVICE_SERIAL=
# Optional verification/encryption code printed on some devices.
YS7_DEVICE_CODE=

# Set this before binding the service to a non-loopback interface.
FALL_SERVICE_API_KEY=replace-with-a-long-random-value

FALL_ROUTE=rtmpose_stgcnpp
FALL_CHECKPOINTS_ROOT=weights/stgcnpp
FALL_YOLO_MODEL=yolo26n-pose.pt
FALL_DEVICE=cuda
FALL_THRESHOLD=0.5
FALL_CONFIRM_WINDOWS=3

# Experimental 1/2/3-second pre-fall prediction branch. It reuses the same
# skeleton window as fall detection, so it does not create a second camera pull.
PREFALL_ENABLED=true
PREFALL_CHECKPOINTS_ROOT=weights/prefall
PREFALL_MIN_POSITIVE_FOLDS=5

# Triggered RGB-video semantic review. Qwen runs asynchronously and does not
# block the real-time skeleton detector. The base model is downloaded separately.
MULTIMODAL_ENABLED=false
MULTIMODAL_MODEL=Qwen/Qwen3-VL-2B-Instruct
MULTIMODAL_DEVICE=cuda
MULTIMODAL_FRAMES=8
MULTIMODAL_BUFFER_FRAMES=160
MULTIMODAL_MAX_NEW_TOKENS=112
MULTIMODAL_COOLDOWN_SECONDS=15
MULTIMODAL_POST_TRIGGER_SECONDS=2.5
MULTIMODAL_TRIGGER_LEVELS=HIGH,FALL_CONFIRMED
MULTIMODAL_ALLOW_DOWNLOAD=false
# Optional QLoRA adapter. Leave empty to use the better-validated zero-shot route.
MULTIMODAL_ADAPTER_PATH=
